FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ripgrep ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

COPY dist/opencode-linux-x64/bin/opencode /usr/local/bin/opencode
LABEL org.opencontainers.image.source="https://github.com/internetisalie/opencode"
USER node
WORKDIR /home/node
EXPOSE 4096
ENTRYPOINT ["opencode"]
